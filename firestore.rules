rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function untuk cek status developer
    function isDev() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('dev', false) == true;
    }

    // Aturan yang fleksibel untuk mendukung Server-Side Bridge (Server Actions)
    match /users/{userId} {
      allow read, write: if true;
      
      match /services/{serviceId} {
        allow read, write: if true;
      }
      
      match /ai/{configId} {
        allow read, write: if true;
      }

      match /transactions/{transactionId} {
        allow read, write: if true;
      }

      match /notifications/{notificationId} {
        allow read, write: if true;
      }
    }

    match /processed_topups/{topupId} {
      allow read, write: if true;
    }

    match /stspay_transactions/{transactionId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /Client_Keys/{keyId} {
      allow read: if true;
      allow write: if isDev() || true;
    }

    match /payment_channels/{channelId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}