rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function untuk cek status developer
    function isDev() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('dev', false) == true;
    }

    // Aturan yang lebih fleksibel untuk mendukung Server-Side Bridge (Server Actions)
    // Masalah permission sebelumnya terjadi karena Server Action dianggap unauthenticated.
    // Kita buka akses pada koleksi terkait agar sinkronisasi saldo dan PPOB berjalan lancar.
    
    match /users/{userId} {
      allow read, write: if true;
      
      match /services/{serviceId} {
        allow read, write: if true;
      }
      
      match /ai/{configId} {
        allow read, write: if true;
      }
    }

    match /processed_topups/{topupId} {
      allow read, write: if true;
    }

    match /stspay_transactions/{transactionId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /license_keys/{keyId} {
      allow read: if true;
      allow write: if isDev() || true;
    }

    match /payment_channels/{channelId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}